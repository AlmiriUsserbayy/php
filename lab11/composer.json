{
    "name": "student/tuition-payments",
    "description": "Оплата обучения: счета и платежи с автозагрузкой PSR-4",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4"
    },
    "autoload": {
        "psr-4": {
            "University\\TuitionPayments\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "University\\TuitionPayments\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "check": [
            "@php -l public/index.php",
            "@php tests/run.php"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
